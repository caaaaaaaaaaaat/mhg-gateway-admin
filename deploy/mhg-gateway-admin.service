[Unit]
Description=MHXX/MHGU crossplay gateway management console
Documentation=file:///srv/mhg-gateway-admin/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mhg
Group=mhg
WorkingDirectory=/srv/mhg-gateway-admin

# NODE_ENV=production keeps the optional-dependency install semantics honest at
# runtime; the actual database and gateway settings live in config.json plus the
# environment below.
Environment=NODE_ENV=production
Environment=MHGA_CONFIG=/srv/mhg-gateway-admin/config.json
Environment=MHGA_HOST=0.0.0.0
Environment=MHGA_PORT=8720
Environment=MHGA_LOG_LEVEL=info

# Point this at the Node 22+ binary if `node` on PATH is older.
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3s

# The console spawns gateway children. When the console stops, systemd kills the
# whole cgroup, so a crashed console cannot leave orphan gateways holding UDP
# ports.
KillMode=control-group
TimeoutStopSec=20

# Hardening: the console needs to write only its own data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mhg-gateway-admin/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Limit journal noise from a crash loop; the console has its own fuse as well.
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
