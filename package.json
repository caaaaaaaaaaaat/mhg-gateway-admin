{
  "name": "mhg-gateway-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side management console for MHXX/MHGU crossplay gateways: web login, batch room management, pluggable datasource (SQLite by default, MySQL optional).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "mhg-gateway-admin": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit.*.test.js\"",
    "test:api": "node --test --test-reporter=spec \"test/api.*.test.js\"",
    "check": "node --check src/index.js && node --check src/app.js"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  },
  "dependencies": {}
}
