# SPDX-License-Identifier: GPL-3.0-or-later
# Ignore generated state, build output and editor noise.

# Runtime state: never commit a database, a session secret or room logs.
# The directory itself is kept (via .gitkeep) so a fresh checkout has somewhere
# for the default relative paths to land.
data/*
!data/.gitkeep
mysql-data/
*.db
*.db-wal
*.db-shm
session-secret
config.json
config.local.json

# Dependencies
node_modules/
# package-lock.json IS committed: it pins the optional mysql2 version, and the
# Dockerfile switches to `npm ci` when a lockfile is present, which is what makes
# an image build reproducible.

# Logs and ad-hoc debug output
*.log
.ag-*.log
.test-*.log
.debug-*.mjs
.debug-*.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Container artifacts
*.tar
*.tar.gz
mhg-gateway-admin-*.tar

# Local gateway binaries. README tells the operator to drop a citra-gateway
# build into bin/; a 23 MB executable must never enter the source history.
/bin/*
!/bin/.gitkeep
