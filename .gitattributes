#
# Line endings matter here: the shell scripts run inside a Linux container, and a
# CRLF shebang line produces "env: sh\r: No such file or directory" at runtime.
# Normalise everything to LF and let Windows checkouts convert only what is
# genuinely platform-local.
* text=auto eol=lf

# Scripts and build inputs must stay LF on every platform.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
.gitignore  text eol=lf
.dockerignore text eol=lf
*.service   text eol=lf

# Binary artifacts are never converted.
*.png   binary
*.jpg   binary
*.ico   binary
*.gz    binary
*.zip   binary
*.db    binary
# The gateway binaries ship with the repository so a fresh clone can start a mapping
# without a compiler. Declaring them binary is what keeps git from touching the bytes:
# a single CRLF substitution bricks an ELF or a PE, and the failure mode is a runtime
# "cannot execute binary file" with nothing in git to show why.
bin/citra-gateway     binary
bin/citra-gateway.exe binary
*.exe                 binary
